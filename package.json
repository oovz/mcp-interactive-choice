{
    "name": "mcp-interactive-choice",
    "version": "2.0.0",
    "type": "module",
    "description": "A MCP server for interactive user questions with native UI",
    "main": "dist/index.js",
    "bin": {
        "mcp-interactive-choice": "dist/index.js"
    },
    "files": [
        "dist",
        "bin",
        "README.md"
    ],
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "build:server": "tsc",
        "build:ui": "npm run build --workspace=native-ui",
        "build": "npm run build:ui && npm run build:server && node scripts/copy-binaries.js",
        "start": "node dist/index.js",
        "test": "vitest run",
        "sync-version": "node scripts/sync-versions.js",
        "version": "npm run sync-version"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.29.0",
        "commander": "^14.0.3",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/node": "^22.10.0",
        "typescript": "^5.9.3",
        "vitest": "^4.1.9"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/oovz/mcp-interactive-choice"
    }
}